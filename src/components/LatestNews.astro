---
import { sanityClient } from "sanity:client";

const news = await sanityClient.fetch(`
    *[_type == "news" && defined(slug.current)]
    // Sort the newest news stories first and returns only the first three
    | order(_createdAt desc)[0...3] {
        _id,
        title,
        "slug": slug.current
    }
`);
---

<section>
    <div class="container">
        <h2>Latest News</h2>

        {
            news.length > 0 ? (
                <ul>
                    {news.map((news) => (
                        <li>
                            <a href={`/news/${news.slug}`}>
                                {news.title}
                            </a>
                        </li>
                    ))}
                </ul>

                <a href="/news">Read all the latest news</a>
            ) : (
                <p>No news articles have been added yet.</p>
            )
        }
    </div>
</section>